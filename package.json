{
  "name": "orgflow",
  "version": "1.0.0",
  "private": true,
  "description": "Organizational Workflow, Task Tracking & Accountability Platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@orgflow/api",
    "dev:web": "npm run dev --workspace=@orgflow/web",
    "build": "npm run build --workspace=@orgflow/api && npm run build --workspace=@orgflow/web",
    "build:api": "npm run build --workspace=@orgflow/api",
    "build:web": "npm run build --workspace=@orgflow/web",
    "start": "concurrently -n api,web -c blue,magenta \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm run start:prod --workspace=@orgflow/api",
    "start:web": "npm run start --workspace=@orgflow/web",
    "typecheck": "npm run typecheck --workspace=@orgflow/api && npm run typecheck --workspace=@orgflow/web",
    "lint": "npm run lint --workspace=@orgflow/api && npm run lint --workspace=@orgflow/web",
    "test": "npm run test --workspace=@orgflow/api",
    "test:unit": "npm run test --workspace=@orgflow/api",
    "test:e2e": "npm run test:e2e --workspace=@orgflow/api",
    "prisma:generate": "npm run prisma:generate --workspace=@orgflow/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@orgflow/api",
    "prisma:deploy": "npm run prisma:deploy --workspace=@orgflow/api",
    "prisma:seed": "npm run prisma:seed --workspace=@orgflow/api",
    "prisma:studio": "npm run prisma:studio --workspace=@orgflow/api",
    "prisma:reset": "npm run prisma:reset --workspace=@orgflow/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "setup": "npm install && npm run prisma:generate && npm run prisma:migrate && npm run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
