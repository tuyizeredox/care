# Render (and most PaaS hosts) set NODE_ENV=production for the build step.
# npm's `omit` config defaults to ["dev"] when NODE_ENV=production, which strips
# every devDependency — including the compilers the build needs:
#   apps/api  -> @nestjs/cli ("nest build"), typescript
#   apps/web  -> typescript, tailwindcss, postcss, autoprefixer
# `include` always wins over `omit`, so this keeps build tooling installed no
# matter which install command the host runs.
#
# Note: prisma survived that pruning only because @prisma/client declares it as
# an optional peer ("devOptional" in the lockfile) -- which is why the API build
# got past `prisma generate` and then died on `sh: 1: nest: not found`.
include=dev
