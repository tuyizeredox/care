# ============================================================================
#  OrgFlow - Environment Variables
#  Copy this file to `.env` (repo root) and fill in real values.
#  NEVER commit a populated .env file.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Pooled connection, used by the running application.
# On a transaction-mode pooler (Neon, Supabase, PgBouncer) append
#   &pgbouncer=true&connection_limit=10&pool_timeout=20
# so Prisma stops issuing prepared statements the pooler cannot carry.
DATABASE_URL="postgresql://care:care@localhost:5432/care?schema=public"

# Interactive transaction budget. Raise these when the database is remote and
# per-query latency is high; lower them for a database on the same network.
DB_TRANSACTION_TIMEOUT_MS=20000
DB_TRANSACTION_MAX_WAIT_MS=10000

# ---------------------------------------------------------------------------
# Application / Networking
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_PREFIX=api
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# File storage  (STORAGE_PROVIDER = local | s3 | cloudinary)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=25

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (SMTP). Leave EMAIL_HOST empty to log emails to the console instead.
# ---------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="OrgFlow <no-reply@orgflow.local>"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
REMINDERS_ENABLED=true
# Cron expression for the deadline reminder sweep (default: every day 07:00)
REMINDERS_CRON="0 7 * * *"

# ---------------------------------------------------------------------------
# Seeding (development only)
# ---------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD=Passw0rd!Demo
